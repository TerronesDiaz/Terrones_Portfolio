---
import Layout from '../layouts/Layout.astro';
import Linkedin from '../icons/Linkedin.astro';
import Github from '../icons/GitHub.astro';
import Mail from '../icons/Mail.astro';
import type { PortfolioContent } from '../data/portfolio';

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
const ids = content.locale === 'es'
  ? { home: 'inicio', experience: 'experiencia', projects: 'proyectos', about: 'sobre-mi', contact: 'contacto' }
  : { home: 'home', experience: 'experience', projects: 'projects', about: 'about', contact: 'contact' };
---

<Layout content={content}>
  <main id="main-content">
    <section class="hero section" id={ids.home} aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{content.hero.eyebrow}</p>
          <h1 id="hero-title">
            {content.hero.title}
            <span>{content.hero.highlight}</span>
          </h1>
          <p class="hero-description">{content.hero.description}</p>

          <div class="hero-actions">
            <a class="button button-primary" href={`#${ids.contact}`}>{content.hero.primaryCta}</a>
            <a class="button button-secondary" href={content.cvPath} download>{content.hero.secondaryCta}</a>
          </div>

          <ul class="specialty-list" aria-label={content.locale === 'es' ? 'Especialidades principales' : 'Core specialties'}>
            {content.hero.specialties.map((specialty) => <li>{specialty}</li>)}
          </ul>
        </div>

        <div class="hero-visual">
          <div class="availability-card">
            <span class="status-dot" aria-hidden="true"></span>
            <span>{content.hero.availability}</span>
          </div>
          <div class="portrait-frame">
            <img
              src="/media/img/Francisco_Terrones.webp"
              alt={content.hero.imageAlt}
              width="640"
              height="640"
              fetchpriority="high"
            />
          </div>
          <dl class="proof-grid">
            {content.hero.proof.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="section" id={ids.experience} aria-labelledby="experience-title">
      <div class="section-heading">
        <p class="eyebrow">{content.experienceSection.eyebrow}</p>
        <h2 id="experience-title">{content.experienceSection.title}</h2>
        <p>{content.experienceSection.description}</p>
      </div>

      <ol class="timeline">
        {content.experiences.map((experience) => (
          <li class="timeline-item">
            <article>
              <div class="timeline-meta">
                <p>{experience.period}</p>
                {experience.current && <span>{content.experienceSection.currentLabel}</span>}
              </div>
              <div class="timeline-content">
                <h3>{experience.role}</h3>
                <p class="company">{experience.company} · {experience.location}</p>
                <ul>
                  {experience.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" id={ids.projects} aria-labelledby="projects-title">
      <div class="section-heading">
        <p class="eyebrow">{content.projectsSection.eyebrow}</p>
        <h2 id="projects-title">{content.projectsSection.title}</h2>
        <p>{content.projectsSection.description}</p>
      </div>

      <div class="project-grid">
        {content.projects.map((project) => (
          <article class="project-card">
            <div class="project-image">
              <img src={project.image} alt={project.imageAlt} width="960" height="620" loading="lazy" decoding="async" />
            </div>
            <div class="project-content">
              <ul class="tag-list" aria-label={content.locale === 'es' ? 'Tecnologías y áreas' : 'Technologies and areas'}>
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer">
                {project.linkLabel}<span aria-hidden="true"> ↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section about-grid" id={ids.about} aria-labelledby="about-title">
      <div class="about-image">
        <img src="/media/img/me.webp" alt={content.about.imageAlt} width="720" height="900" loading="lazy" decoding="async" />
      </div>
      <div class="about-content">
        <p class="eyebrow">{content.about.eyebrow}</p>
        <h2 id="about-title">{content.about.title}</h2>
        {content.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

        <div class="about-details">
          <div>
            <h3>{content.about.educationLabel}</h3>
            <p>{content.about.education}</p>
          </div>
          <div>
            <h3>{content.about.skillsLabel}</h3>
            <ul class="skill-list">
              {content.about.skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section contact-section" id={ids.contact} aria-labelledby="contact-title">
      <div class="contact-copy">
        <p class="eyebrow">{content.contact.eyebrow}</p>
        <h2 id="contact-title">{content.contact.title}</h2>
        <p>{content.contact.description}</p>
      </div>
      <div class="contact-actions">
        <a class="contact-link" href={`mailto:${content.shared.email}`}>
          <Mail class="contact-icon" aria-hidden="true" />
          <span>{content.contact.emailLabel}</span>
        </a>
        <a class="contact-link" href={content.shared.linkedin} target="_blank" rel="noopener noreferrer">
          <Linkedin class="contact-icon" aria-hidden="true" />
          <span>{content.contact.linkedinLabel}</span>
        </a>
        <a class="contact-link" href={content.shared.whatsapp} target="_blank" rel="noopener noreferrer">
          <span class="contact-icon contact-icon-text" aria-hidden="true">WA</span>
          <span>{content.contact.whatsappLabel}</span>
        </a>
        <a class="contact-link" href={content.shared.github} target="_blank" rel="noopener noreferrer">
          <Github class="contact-icon" aria-hidden="true" />
          <span>GitHub</span>
        </a>
      </div>
    </section>
  </main>
</Layout>
